{
  "ActionList": {
    "LoadSoilInputs": {
      "Arguments": {
        "sensor_csv_path": "data/sites_vwc_corrected.csv",
        "site_locations_path": "data/site_locations.json",
        "staging_prefix": "soil_sensor_processing/staging"
      },
      "InvokeNext": [
        "DownloadMergeWeather"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "load_soil_inputs"
    },
    "DownloadMergeWeather": {
      "Arguments": {
        "staging_prefix": "soil_sensor_processing/staging",
        "output_prefix": "soil_sensor_processing/output",
        "sensor_file": "sensor_observations_standardized.csv",
        "locations_file": "site_locations.json",
        "agrimet_station": "BEWO",
        "request_timeout_seconds": 90,
        "gridmet_workers": 4
      },
      "InvokeNext": [
        "DetectSensorMalfunctions"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "download_weather_data"
    },
    "DetectSensorMalfunctions": {
      "Arguments": {
        "staging_prefix": "soil_sensor_processing/staging",
        "qc_prefix": "soil_sensor_processing/qc",
        "sensor_file": "sensor_observations_standardized.csv",
        "cleaned_sensor_file": "sensor_observations_qc_cleaned.csv",
        "removed_sensor_file": "sensor_observations_qc_removed.csv",
        "qc_manifest_file": "sensor_qc_manifest.json",
        "problem_layer_depth": 6,
        "site2_cutoff_date": "2025-07-15"
      },
      "InvokeNext": [
        "CreateFinalMergedCSV"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "detect_sensor_malfunctions"
    },
    "CreateFinalMergedCSV": {
      "Arguments": {
        "qc_prefix": "soil_sensor_processing/qc",
        "output_prefix": "soil_sensor_processing/output",
        "cleaned_sensor_file": "sensor_observations_qc_cleaned.csv",
        "agrimet_file": "agrimet_daily.csv",
        "gridmet_file": "gridmet_daily_by_site.csv",
        "final_file": "soil_moisture_weather_merged.csv",
        "final_manifest_file": "final_merge_manifest.json"
      },
      "InvokeNext": [
        "DetectClassifyReconstructGaps"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "create_final_merged_csv"
    },
    "DetectClassifyReconstructGaps": {
      "Arguments": {
        "output_prefix": "soil_sensor_processing/output",
        "gap_prefix": "soil_sensor_processing/gap_reconstruction",
        "merged_file": "soil_moisture_weather_merged.csv",
        "agrimet_file": "agrimet_daily.csv",
        "gridmet_file": "gridmet_daily_by_site.csv",
        "reconstructed_file": "soil_moisture_gap_reconstructed.csv",
        "gap_catalog_file": "soil_moisture_gap_catalog.csv",
        "sensor_summary_file": "soil_moisture_gap_sensor_summary.csv",
        "gap_manifest_file": "gap_reconstruction_manifest.json",
        "short_gap_max_steps": 6,
        "expected_weekdays": "auto"
      },
      "InvokeNext": [
        "DetectOutliers"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "reconstruct_missing_gaps"
    },
    "DetectOutliers": {
      "Arguments": {
        "gap_prefix": "soil_sensor_processing/gap_reconstruction",
        "outlier_prefix": "soil_sensor_processing/outlier_detection",
        "reconstructed_file": "soil_moisture_gap_reconstructed.csv",
        "flagged_file": "soil_moisture_outlier_flagged.csv",
        "outlier_catalog_file": "soil_moisture_outlier_catalog.csv",
        "sensor_summary_file": "soil_moisture_outlier_sensor_summary.csv",
        "outlier_manifest_file": "outlier_detection_manifest.json",
        "moving_window": 7,
        "minimum_absolute_deviation": 0.03,
        "z_threshold": 3,
        "modified_z_threshold": 3.5,
        "hampel_threshold": 3,
        "iqr_multiplier": 1.5,
        "stl_period_steps": 156,
        "stl_min_cycles": 2,
        "machine_learning_contamination": 0.01,
        "dbscan_distance_quantile": 0.99,
        "random_state": 42
      },
      "InvokeNext": [],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "detect_outliers"
    }
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UseSecretStore": true,
      "ActionRepoName": "FaaSr-workflow",
      "Branch": "main",
      "UserName": "Mallika-Guptaa"
    }
  },
  "DataStores": {
    "S3PRIVATE": {
      "Bucket": "faasr-bucket-smarttap-private",
      "Region": "us-east-1",
      "Writable": "TRUE"
    }
  },
  "ActionContainers": {
    "LoadSoilInputs": "ghcr.io/faasr/github-actions-python:latest",
    "DownloadMergeWeather": "ghcr.io/faasr/github-actions-python:latest",
    "DetectSensorMalfunctions": "ghcr.io/faasr/github-actions-python:latest",
    "CreateFinalMergedCSV": "ghcr.io/faasr/github-actions-python:latest",
    "DetectClassifyReconstructGaps": "ghcr.io/faasr/github-actions-python:latest",
    "DetectOutliers": "ghcr.io/faasr/github-actions-python:latest"
  },
  "FunctionInvoke": "LoadSoilInputs",
  "DefaultDataStore": "S3PRIVATE",
  "FunctionGitRepo": {
    "load_soil_inputs": "Mallika-Guptaa/soil-senors/python",
    "download_weather_data": "Mallika-Guptaa/soil-senors/python",
    "detect_sensor_malfunctions": "Mallika-Guptaa/soil-senors/python",
    "create_final_merged_csv": "Mallika-Guptaa/soil-senors/python",
    "reconstruct_missing_gaps": "Mallika-Guptaa/soil-senors/python",
    "detect_outliers": "Mallika-Guptaa/soil-senors/python"
  },
  "PyPIPackageDownloads": {
    "load_soil_inputs": [
      "pandas",
      "requests"
    ],
    "download_weather_data": [
      "pandas",
      "requests"
    ],
    "detect_sensor_malfunctions": [
      "pandas",
      "requests"
    ],
    "create_final_merged_csv": [
      "pandas",
      "requests"
    ],
    "reconstruct_missing_gaps": [
      "pandas",
      "requests",
      "scipy",
      "scikit-learn",
      "xgboost"
    ],
    "detect_outliers": [
      "pandas",
      "requests",
      "scikit-learn",
      "statsmodels"
    ]
  },
  "Secrets": [],
  "FaaSrLog": "FaaSrLog",
  "LoggingDataStore": "S3PRIVATE",
  "WorkflowName": "SoilSensorWeatherMerge"
}
