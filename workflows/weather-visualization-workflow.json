{
  "FunctionInvoke": "inspect-csv-and-create-variable-manifest",
  "WorkflowName": "weather-visualization-workflow",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "inspect-csv-and-create-variable-manifest": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "inspect_csv_and_create_variable_manifest",
      "Arguments": {
        "folder": "WeatherVisualization/OpenCodeTest",
        "input1": "WeatherData.csv",
        "output1": "weather_variable_manifest.json"
      },
      "InvokeNext": [
        "plot-numeric-variables-to-png"
      ]
    },
    "plot-numeric-variables-to-png": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "plot_numeric_variables_to_png",
      "Arguments": {
        "folder": "WeatherVisualization/OpenCodeTest",
        "input1": "WeatherData.csv",
        "output1": "plots_generation_complete.json"
      },
      "InvokeNext": [
        "generate-plot-manifest-from-remote-prefix"
      ]
    },
    "generate-plot-manifest-from-remote-prefix": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "generate_plot_manifest_from_remote_prefix",
      "Arguments": {
        "folder": "WeatherVisualization/OpenCodeTest",
        "input1": "plots_generation_complete.json",
        "output1": "weather_plot_manifest.json"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "inspect-csv-and-create-variable-manifest": "ghcr.io/faasr/github-actions-python:latest",
    "plot-numeric-variables-to-png": "ghcr.io/faasr/github-actions-python:latest",
    "generate-plot-manifest-from-remote-prefix": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "Mallika-Guptaa",
      "ActionRepoName": "FaaSr-workflow",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.amazonaws.com",
      "Bucket": "faasr-bucket-smarttap-private",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "inspect_csv_and_create_variable_manifest": "Mallika-Guptaa/FaaSr-workflow/main/functions/inspect_csv_and_create_variable_manifest.py",
    "plot_numeric_variables_to_png": "Mallika-Guptaa/FaaSr-workflow/main/functions/plot_numeric_variables_to_png.py",
    "generate_plot_manifest_from_remote_prefix": "Mallika-Guptaa/FaaSr-workflow/main/functions/generate_plot_manifest_from_remote_prefix.py"
  },
  "PyPIPackageDownloads": {
    "inspect_csv_and_create_variable_manifest": [
      "pandas>=2.0.0"
    ],
    "plot_numeric_variables_to_png": [
      "pandas",
      "matplotlib"
    ]
  }
}