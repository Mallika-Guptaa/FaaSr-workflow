{
  "FunctionInvoke": "generate-points",
  "WorkflowName": "simple-function-plot",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "generate-points": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "generate_points",
      "Arguments": {
        "folder": "workflow_data",
        "output1": "claude_points.csv"
      },
      "InvokeNext": [
        "create-plot"
      ]
    },
    "create-plot": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "create_plot",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "claude_points.csv",
        "output1": "claude_plot.png"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "generate-points": "ghcr.io/faasr/github-actions-python:latest",
    "create-plot": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "Mallika-Guptaa",
      "ActionRepoName": "FaaSr-workflow",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.amazonaws.com",
      "Bucket": "faasr-bucket-smarttap-private",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "generate_points": "Mallika-Guptaa/FaaSr-workflow/main/functions/generate_points.py",
    "create_plot": "Mallika-Guptaa/FaaSr-workflow/main/functions/create_plot.py"
  },
  "PyPIPackageDownloads": {
    "generate_points": [
      "numpy",
      "pandas"
    ],
    "create_plot": [
      "matplotlib",
      "pandas"
    ]
  }
}