{
  "FunctionInvoke": "load-vwc-data",
  "WorkflowName": "vwc-site-plots-workflow",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "load-vwc-data": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "load_vwc_data",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "sites_vwc_corrected.csv",
        "output1": "vwc_validated.csv"
      },
      "InvokeNext": [
        "download-weather-data",
        "create-site-locations-json"
      ]
    },
    "download-weather-data": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "download_weather_data",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "vwc_validated.csv",
        "output1": "agrimet.csv",
        "output2": "gridmet.csv",
        "output3": "weather_merged.csv"
      },
      "InvokeNext": [
        "generate-site-plots"
      ]
    },
    "generate-site-plots": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "generate_site_plots",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "vwc_validated.csv",
        "output1": "site_1_vwc_plot.png",
        "output2": "site_2_vwc_plot.png",
        "output3": "site_3_vwc_plot.png",
        "output4": "site_4_vwc_plot.png"
      },
      "InvokeNext": [
        "upload-plots"
      ]
    },
    "upload-plots": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "upload_plots",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "site_1_vwc_plot.png",
        "input2": "site_2_vwc_plot.png",
        "input3": "site_3_vwc_plot.png",
        "input4": "site_4_vwc_plot.png",
        "output1": "site_1_vwc_plot_uploaded.png",
        "output2": "site_2_vwc_plot_uploaded.png",
        "output3": "site_3_vwc_plot_uploaded.png",
        "output4": "site_4_vwc_plot_uploaded.png"
      },
      "InvokeNext": []
    },
    "create-site-locations-json": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "create_site_locations_json",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "vwc_validated.csv",
        "output1": "site_locations.json"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "load-vwc-data": "ghcr.io/faasr/github-actions-python:latest",
    "download-weather-data": "ghcr.io/faasr/github-actions-python:latest",
    "generate-site-plots": "ghcr.io/faasr/github-actions-python:latest",
    "upload-plots": "ghcr.io/faasr/github-actions-python:latest",
    "create-site-locations-json": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "Mallika-Guptaa",
      "ActionRepoName": "FaaSr-workflow",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.amazonaws.com",
      "Bucket": "faasr-bucket-smarttap-private",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "load_vwc_data": "Mallika-Guptaa/FaaSr-workflow/main/functions/load_vwc_data.py",
    "download_weather_data": "Mallika-Guptaa/FaaSr-workflow/main/functions/download_weather_data.py",
    "generate_site_plots": "Mallika-Guptaa/FaaSr-workflow/main/functions/generate_site_plots.py",
    "upload_plots": "Mallika-Guptaa/FaaSr-workflow/main/functions/upload_plots.py",
    "create_site_locations_json": "Mallika-Guptaa/FaaSr-workflow/main/functions/create_site_locations_json.py"
  },
  "PyPIPackageDownloads": {
    "load_vwc_data": [
      "pandas"
    ],
    "download_weather_data": [
      "requests",
      "pandas",
      "numpy",
      "xarray",
      "netCDF4"
    ],
    "generate_site_plots": [
      "pandas",
      "matplotlib"
    ],
    "create_site_locations_json": [
      "pandas"
    ]
  }
}