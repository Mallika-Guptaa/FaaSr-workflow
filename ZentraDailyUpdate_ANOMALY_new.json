{
  "ActionList": {
    "FetchDailyZentraRaw": {
      "Arguments": {
        "serial_numbers": "ALL",
        "lookback_hours": 26,
        "buffer_hours": 1,
        "raw_prefix": "zentra_raw_backfill",
        "state_prefix": "zentra_daily_update_state",
        "per_page": 2000,
        "sleep_seconds": 65,
        "sleep_between_serials": 2,
        "server": "https://zentracloud.com",
        "api_version": "v4",
        "ports": "AUTO"
      },
      "InvokeNext": [
        "Update12ConfigsFromDailySummary"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "fetch_daily_zentra_raw"
    },
    "Update12ConfigsFromDailySummary": {
      "Arguments": {
        "raw_prefix": "zentra_raw_backfill",
        "daily_state_prefix": "zentra_daily_update_state",
        "daily_summary_file": "daily_update_summary_latest.json",
        "output_prefix": "zentra_final_12_configs",
        "manifest_prefix": "zentra_processing_state",
        "manifest_file": "processed_raw_manifest.json",
        "update_summary_file": "daily_12config_update_summary_latest.json",
        "timezone_name": "America/Los_Angeles"
      },
      "InvokeNext": [
        "UpdateMonthlyAverages",
        "DetectDailyZentraAnomaliesAndEmail"
      ],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "update_12_configs_from_daily_summary"
    },
    "UpdateMonthlyAverages": {
      "Arguments": {
        "input_prefix": "zentra_final_12_configs",
        "output_prefix": "Zentra_monthly_averages",
        "processing_state_prefix": "zentra_processing_state",
        "daily_12_summary_file": "daily_12config_update_summary_latest.json",
        "timezone_name": "America/Los_Angeles",
        "average_method": "daily_mean",
        "exclude_error_rows": true,
        "conflict_policy": "keep_distinct",
        "minimum_day_coverage_ratio": 0.8
      },
      "InvokeNext": [],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "update_monthly_averages_incremental"
    },
    "DetectDailyZentraAnomaliesAndEmail": {
        "Arguments": {
          "raw_prefix": "zentra_raw_backfill",
          "state_prefix": "zentra_daily_update_state",
          "latest_summary_file": "daily_update_summary_latest.json",
          "alert_prefix": "zentra_anomaly_alerts",
          "sent_ids_file": "sent_anomaly_ids.json",
          "max_rows_in_email": 20,
          "dry_run": false,
          "logger_silence_hours": 6,
          "logger_silence_state_file": "logger_silence_state.json"
        },
      "InvokeNext": [],
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "detect_daily_zentra_anomalies_and_send_email"
    }
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UseSecretStore": true,
      "ActionRepoName": "FaaSr-workflow",
      "Branch": "main",
      "UserName": "Mallika-Guptaa"
    }
  },
  "DataStores": {
    "S3PRIVATE": {
      "Bucket": "faasr-bucket-smarttap-private",
      "Region": "us-east-1",
      "Writable": "TRUE"
    }
  },
  "ActionContainers": {
    "FetchDailyZentraRaw": "ghcr.io/faasr/github-actions-python:latest",
    "Update12ConfigsFromDailySummary": "ghcr.io/faasr/github-actions-python:latest",
    "UpdateMonthlyAverages": "ghcr.io/faasr/github-actions-python:latest",
    "DetectDailyZentraAnomaliesAndEmail": "ghcr.io/faasr/github-actions-python:latest"
  },
  "FunctionInvoke": "FetchDailyZentraRaw",
  "DefaultDataStore": "S3PRIVATE",
  "FunctionGitRepo": {
    "fetch_daily_zentra_raw": "Mallika-Guptaa/zentra_backfill_workflow_files/python",
    "update_12_configs_from_daily_summary": "Mallika-Guptaa/zentra_backfill_workflow_files/python",
    "update_monthly_averages_incremental": "Mallika-Guptaa/zentra_backfill_workflow_files/python",
    "detect_daily_zentra_anomalies_and_send_email": "Mallika-Guptaa/zentra_backfill_workflow_files/python"
  },
  "PyPIPackageDownloads": {
    "fetch_daily_zentra_raw": [
      "pandas",
      "requests"
    ],
    "update_12_configs_from_daily_summary": [
      "pandas"
    ],
    "update_monthly_averages_incremental": [
      "pandas"
    ],
    "detect_daily_zentra_anomalies_and_send_email": [
      "pandas",
      "requests"
    ]
  },
  "Secrets": [
    "ZENTRA_TOKEN",
    "RESEND_API_KEY",
    "ALERT_EMAIL_FROM",
    "ALERT_EMAIL_TO"
  ],
  "FaaSrLog": "FaaSrLog",
  "LoggingDataStore": "S3PRIVATE",
  "WorkflowName": "ZentraSmartTAPDailyPipeline"
}
